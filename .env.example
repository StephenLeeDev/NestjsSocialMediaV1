# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# Server
PORT=3001
SERVER_URL=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=social-media-app-v1
# true only for local development (auto-creates/alters tables)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=21900
